# ──────────────────────────────────────────────────────────────────────────
# Truecopy — environment
#
# Every name below carries the NEXT_ prefix so the list reads consistently in
# the Amplify console. None of them uses NEXT_PUBLIC_, and that distinction is
# the whole point: NEXT_PUBLIC_ compiles a value into the JavaScript that ships
# to the browser. Never put a secret, an API key, or a credential behind it.
# ──────────────────────────────────────────────────────────────────────────

# Where the app is reachable. Set this in Amplify so the OAuth redirect URIs
# are built from the custom domain rather than the CloudFront host.
NEXT_APP_ORIGIN=https://hire.oceanbluecorp.com
NEXT_AWS_REGION=us-east-2

# ── Extraction engine ─────────────────────────────────────────────────────
# The browser uploads resumes straight to this URL. That is not a shortcut:
# the pipeline runs 30-90s and Amplify's CloudFront closes any proxied
# response at 30s, so a proxied upload returns 504 for every real resume.
#
# The URL is still not in the browser bundle — /api/extract/ticket hands it
# out, and only to a verified session.
NEXT_EXTRACTION_API_URL=https://<function-url>.lambda-url.us-east-2.on.aws

# Signs the short-lived upload ticket the engine checks. Must match
# EXTRACTION_SHARED_SECRET on the engine exactly, or every upload is refused.
# Generate with: openssl rand -hex 32
#
# Server-only, and it must stay that way — anything holding this can mint
# tickets. Never move it behind NEXT_PUBLIC_.
NEXT_EXTRACTION_SHARED_SECRET=

# Removed: NEXT_EXTRACTION_API_KEY. Nothing set it, the engine never checked
# it, and the route that sent it read EXTRACTION_API_KEY without the NEXT_
# prefix the build copies into the runtime. It authenticated nothing.

# ── Cognito (server-only) ─────────────────────────────────────────────────
# The OAuth code exchange runs in route handlers and the tokens are stored in
# httpOnly cookies, so none of this needs to be public.
NEXT_COGNITO_USER_POOL_ID=
NEXT_COGNITO_CLIENT_ID=
NEXT_COGNITO_DOMAIN=https://your-pool.auth.us-east-2.amazoncognito.com
NEXT_COGNITO_SCOPES=openid email profile
# Only for a confidential app client. A public SPA client has no secret.
# NEXT_COGNITO_CLIENT_SECRET=

# In the Cognito app client, set:
#   Allowed callback URL  ->  https://hire.oceanbluecorp.com/api/auth/callback
#   Allowed sign-out URL  ->  https://hire.oceanbluecorp.com/signed-out
# and enable the Authorization code grant with PKCE.
#
# Leave the Cognito values unset to run the app open — useful locally.

# ── Resume match service (server-only) ────────────────────────────────────
# Reached only through /api/match/*: ranking a job against the resume bank,
# scoring one resume, and adding resumes to the bank. Both values stay on the
# server — the browser calls this app, never the engine.
NEXT_RESUME_MATCH_API_URL=https://<function-url>.lambda-url.us-east-2.on.aws
NEXT_RESUME_MATCH_API_KEY=
# Bulk upload (/api/match/ingest) parses each file through the extraction
# engine, so the match service needs its own RESUME_PARSER_URL configured.

# ── Never put these in a frontend env file ────────────────────────────────
# AWS IAM access keys belong in the Amplify service role, the backend's
# execution role, or a secrets manager — not here. If a pair has ever been
# written into an env file, rotate it in IAM before shipping.
