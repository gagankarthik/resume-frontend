# ──────────────────────────────────────────────────────────────────────────
# Truecopy — environment
#
# Every name below carries the NEXT_ prefix so the list reads consistently in
# the Amplify console. None of them uses NEXT_PUBLIC_, and that distinction is
# the whole point: NEXT_PUBLIC_ compiles a value into the JavaScript that ships
# to the browser. Never put a secret, an API key, or a credential behind it.
# ──────────────────────────────────────────────────────────────────────────

# Where the app is reachable. Set this in Amplify so the OAuth redirect URIs
# are built from the custom domain rather than the CloudFront host.
NEXT_APP_ORIGIN=https://truecopy.example.com
NEXT_AWS_REGION=us-east-2

# ── Extraction engine (server-only) ───────────────────────────────────────
# Called from /api/extract. The browser never sees this URL.
NEXT_EXTRACTION_API_URL=https://<function-url>.lambda-url.us-east-2.on.aws
# NEXT_EXTRACTION_API_KEY=

# ── Cognito (server-only) ─────────────────────────────────────────────────
# The OAuth code exchange runs in route handlers and the tokens are stored in
# httpOnly cookies, so none of this needs to be public.
NEXT_COGNITO_USER_POOL_ID=
NEXT_COGNITO_CLIENT_ID=
NEXT_COGNITO_DOMAIN=https://your-pool.auth.us-east-2.amazoncognito.com
NEXT_COGNITO_SCOPES=openid email profile
# Only for a confidential app client. A public SPA client has no secret.
# NEXT_COGNITO_CLIENT_SECRET=

# In the Cognito app client, set:
#   Allowed callback URL  ->  {NEXT_APP_ORIGIN}/api/auth/callback
#   Allowed sign-out URL  ->  {NEXT_APP_ORIGIN}/signed-out
# and enable the Authorization code grant with PKCE.
#
# Leave the Cognito values unset to run the app open — useful locally.

# ── Resume match service (server-only) ────────────────────────────────────
NEXT_RESUME_MATCH_API_URL=
NEXT_RESUME_MATCH_API_KEY=

# ── Never put these in a frontend env file ────────────────────────────────
# AWS IAM access keys belong in the Amplify service role, the backend's
# execution role, or a secrets manager — not here. If a pair has ever been
# written into an env file, rotate it in IAM before shipping.
